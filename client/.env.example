# Copy to .env.local to change these for your machine. Vite exposes VITE_* values
# to the browser bundle, so never put secrets here.

# "api" (default): use the CareerFlow API — run `npm run dev` in /server first.
# "mock": in-memory sample data with no server or sign-in, for frontend-only work.
#         Ignored in production builds, which always use the API.
VITE_DATA_SOURCE=api

# API base URL. Leave unset in development: "/api" is proxied to http://localhost:4000.
# Set it for production builds when the API is on another domain (Level 9).
# VITE_API_BASE_URL=https://api.example.com/api
