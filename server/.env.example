# Copy to .env and adjust. Never commit .env — it may contain secrets.

# development | production (tests set "test" automatically)
NODE_ENV=development

PORT=4000

# Local MongoDB, or a MongoDB Atlas connection string (set up in Level 4), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careerflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/careerflow

# Browser origin(s) of the frontend allowed to call the API (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

# Development only, until authentication (Level 5): the user every request acts as.
# Must NOT be set in production — the server refuses to start if it is.
# DEV_USER_ID=000000000000000000000001
