# Copy to .env and adjust. Never commit .env — it contains secrets.

# development | production (tests set "test" automatically)
NODE_ENV=development

PORT=4000

# Local MongoDB, or a MongoDB Atlas connection string (see README), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careerflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/careerflow

# Browser origin(s) of the frontend allowed to call the API (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

# Signs session tokens. Required; at least 32 characters; unique per environment.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a sign-in lasts, in days.
SESSION_DAYS=7

# Session cookie settings. Secure cookies need HTTPS; defaults to true in production.
# COOKIE_SECURE=true
# "lax" when frontend and API share a site (e.g. app.example.com + api.example.com);
# "none" only if they are on different sites (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (1 on most hosting platforms).
TRUST_PROXY=0

# bcrypt cost factor (default 12; at least 10 in production).
# BCRYPT_ROUNDS=12
